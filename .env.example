# Google Gemini API key (Required for Cloud mode)
GOOGLE_API_KEY="your-gemini-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Hugging Face token (Optional for accessing gated models)
HF_TOKEN="your-huggingface-token"

# Primary Cloud Model (Ultra-low latency, recommended gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Secondary Cloud Fallback Model
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Set to true for local CPU/GPU fallback (LaMini-Flan-T5-783M), or false for lightweight cloud containers
ENABLE_LOCAL_LAMINI=true

